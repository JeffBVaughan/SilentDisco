[Unit]
Description=SilentDisco front face (LED ring + OLED)
After=snapserver.service network-online.target
Wants=snapserver.service

[Service]
Type=simple
# root: the WS2812 PWM driver needs DMA access
User=root
EnvironmentFile=-/etc/default/silentdisco-face
ExecStart=/opt/silentdisco-face/bin/python /opt/silentdisco-face/face.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
